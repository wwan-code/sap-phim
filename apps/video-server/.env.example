PORT=3002
NODE_ENV=development

# Redis (Shared with Main Backend)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Internal API Key (matches Main Backend VIDEO_SERVER_API_KEY)
INTERNAL_KEY=your-internal-key

# Upload Token Secret (matches Main Backend UPLOAD_TOKEN_SECRET)
UPLOAD_TOKEN_SECRET=your-upload-token-secret

# Storage paths
UPLOAD_DIR=./storage/uploads
OUTPUT_DIR=./storage/media

# FFmpeg config
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Main Backend callback
MAIN_BACKEND_URL=http://localhost:5000
