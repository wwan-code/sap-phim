{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@admin/*": [
        "src/admin/*"
      ],
      "@app/*": [
        "src/app/*"
      ],
      "@components/*": [
        "src/shared/components/*"
      ],
      "@constants/*": [
        "src/shared/constants/*"
      ],
      "@contexts/*": [
        "src/shared/contexts/*"
      ],
      "@utils/*": [
        "src/shared/utils/*"
      ],
      "@pages/*": [
        "src/pages/*"
      ],
      "@hooks/*": [
        "src/hooks/*"
      ],
      "@config/*": [
        "src/config/*"
      ],
      "@store/*": [
        "src/store/*"
      ],
      "@services/*": [
        "src/shared/services/*"
      ],
      "@lib/*": [
        "src/shared/lib/*"
      ],
      "@routes/*": [
        "src/app/routes/*"
      ],
      "@styles/*": [
        "src/assets/styles/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ],
      "@assets/*": [
        "src/assets/*"
      ],
      "@features/*": [
        "src/features/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist"
  ]
}