# @file .env.example
# @module Client/Configuration
# @description Public client configuration template. Never put server secrets in VITE_* variables.
VITE_API_URL=/api/v1
VITE_BACKEND_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
VITE_VIDEO_SERVER_URL=http://localhost:3002
VITE_TUS_UPLOAD_URL=http://localhost:5173/upload/tus
VITE_API_TIMEOUT=30000
VITE_APP_NAME=Sap Phim
VITE_APP_VERSION=1.0.0
VITE_DEFAULT_LOCALE=vi
VITE_ENABLE_ANALYTICS=false

# Optional Firebase web application settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
