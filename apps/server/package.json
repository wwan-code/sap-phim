{
  "name": "sap-phim-backend",
  "version": "1.0.0",
  "description": "Backend API for Sạp Phim - Cinema streaming platform",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon --config nodemon.json server.js",
    "start": "node server.js",
    "build": "node --check server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests && npm run test:ai",
    "test:ai": "node scripts/test-ai-platform.mjs",
    "test:movie": "node scripts/test-movie-flow.mjs",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all"
  },
  "sequelize": {
    "config": "src/config/sequelize.cjs",
    "models-path": "src/models",
    "migrations-path": "src/migrations",
    "seeders-path": "src/seeders"
  },
  "keywords": [
    "api",
    "express",
    "sequelize",
    "postgresql"
  ],
  "author": "",
  "license": "MIT",
  "engines": { "node": ">=22.15.0" },
  "dependencies": {
    "@bull-board/api": "^8.1.2",
    "@bull-board/express": "^8.1.2",
    "@google/genai": "^2.30.0",
    "@maxmind/geoip2-node": "^6.3.4",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.85.0",
    "@tus/file-store": "^2.0.0",
    "@tus/server": "^2.3.0",
    "argon2": "^0.44.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.10",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^12.7.0",
    "fuse.js": "^7.1.0",
    "geoip-lite": "^1.4.10",
    "heic-convert": "^2.1.0",
    "helmet": "^8.1.0",
    "http-proxy-middleware": "^4.2.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.8.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.10",
    "onnxruntime-node": "^1.23.2",
    "pg": "^8.16.0",
    "pg-hstore": "^2.3.4",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^4.3.1",
    "rrule": "^2.8.1",
    "sequelize": "^6.37.7",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "ua-parser-js": "^2.0.10",
    "uuid": "^13.0.2",
    "validator": "^13.15.26",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "sequelize-cli": "^6.6.3"
  }
}
