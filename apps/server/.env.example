# @file .env.example
# @module Server/Configuration
# @description Local server template. Fill required secrets before starting the application.
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sap_phim
DB_USER=postgres
DB_PASSWORD=
DB_DIALECT=postgres
DB_SSL=false

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Must match the root .env when using Docker Redis.
REDIS_PASSWORD=
REDIS_TLS=false

# Required: generate distinct random values, do not use example credentials.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=30d

FIREBASE_ENABLED=false
FIREBASE_SERVICE_ACCOUNT_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

TMDB_API_KEY=
OMDB_API_KEY=
JIKAN_BASE_URL=https://api.jikan.moe/v4
AI_SUGGEST_ENABLED=true
AI_SUGGEST_ACCEPTING_JOBS=true
AI_SUGGEST_WORKER_ENABLED=true
GEMINI_API_KEY=
GEMINI_FREE_TIER_CONFIRMED=false
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FREE_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

VIDEO_SERVER_URL=http://localhost:3002
# Must match VIDEO_SERVER_API_KEY / UPLOAD_TOKEN_SECRET in root .env,
# and INTERNAL_KEY / UPLOAD_TOKEN_SECRET in apps/video-server/.env.
VIDEO_SERVER_API_KEY=
UPLOAD_TOKEN_SECRET=
TUS_PUBLIC_URL=http://localhost:5173/upload/tus
